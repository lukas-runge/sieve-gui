# Hand-written script (not generated by Roundcube)

require ["fileinto","imap4flags"];
# rule:[Known rule]
if allof (header :contains "subject" "known")
{
	fileinto "Newsletters";
}
if header :contains "subject" "unnamed"
{
	keep;
}
# rule:[Second known]
if address :domain :is "from" "example.com"
{
	addflag "\\Seen";
}
