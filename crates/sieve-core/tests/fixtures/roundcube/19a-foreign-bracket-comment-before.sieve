# Hand-written script (not generated by Roundcube)
require ["fileinto", "imap4flags"];

/* A bracket comment
   spanning two lines */

# rule:[Known rule]
if header :contains "subject" "known" {
    fileinto "Taxes";
}

# just a free-standing comment, not a rule name
if header :contains "subject" "unnamed" { keep; }

# rule:[Second known]
if address :domain :is "from" "example.com" { addflag "\\Seen"; }
