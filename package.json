{
  "name": "sieve-gui",
  "version": "0.1.0",
  "description": "A desktop editor for server-side Sieve mail filters via ManageSieve.",
  "type": "module",
  "imports": {
    "#tauri/*": "./src/generated/tauri/*.ts"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "generate:tauri": "tauri-ts-generator generate",
    "postinstall": "cargo install --git https://github.com/lukas-runge/tauri-codegen --branch fix/workspace-serde-errors tauri-ts-generator && pnpm run generate:tauri",
    "predev": "pnpm run generate:tauri",
    "prebuild": "pnpm run generate:tauri",
    "precheck": "pnpm run generate:tauri",
    "precheck:watch": "pnpm run generate:tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "daisyui": "^5.7.50",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
