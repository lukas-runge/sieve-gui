              ],
              "conditions": {
                "items": [
                  {
                    "negate": false,
                    "test": {
                      "headers": [
                        "subject"
                      ],
                      "keys": [
                        "invoice"
                      ],
                      "matcher": {
                        "comparator": null,
                        "matchType": {
                          "type": "contains"
                        }
                      },
                      "type": "header"
                    }
                  }
                ],
                "join": "any"
              }
            }
          ],
          "enabled": true,
          "name": "Clients",
          "otherwise": null,
          "type": "rule"
        },
        {
          "actions": [
            {
              "copy": false,
              "create": false,
              "flags": null,
              "mailbox": "Reading",
              "type": "fileInto"
            }
          ],
          "conditions": {
            "items": [
              {
                "negate": false,
                "test": {
                  "headers": [
                    "List-Unsubscribe"
                  ],
                  "type": "exists"
                }
              }
            ],
            "join": "any"
          },
          "elsif": [],
          "enabled": true,
          "name": "Newsletters",
          "otherwise": null,
          "type": "rule"
        },
        {
          "actions": [
            {
              "copy": false,
              "create": false,
              "flags": null,
              "mailbox": "Receipts/Shop",
              "type": "fileInto"
            }
          ],
          "conditions": {
            "items": [
              {
                "negate": false,
                "test": {
                  "headers": [
                    "from"
                  ],
                  "keys": [
                    "shop.example"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "type": "is"
                    }
                  },
                  "part": "domain",
                  "type": "address"
                }
              }
            ],
            "join": "any"
          },
          "elsif": [],
          "enabled": true,
          "name": "Receipts",
          "otherwise": null,
          "type": "rule"
        },
        {
          "actions": [
            {
              "copy": false,
              "create": false,
              "flags": null,
              "mailbox": "Receipts/Books",
              "type": "fileInto"
