{
  "Archive": {
    "rules": {
      "items": [
        {
          "actions": [
            {
              "copy": false,
              "create": false,
              "flags": null,
              "mailbox": "Archive/Lists",
              "type": "fileInto"
            }
          ],
          "conditions": {
            "items": [
              {
                "negate": false,
                "test": {
                  "headers": [
                    "list-id"
                  ],
                  "keys": [
                    "announce.example"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "type": "contains"
                    }
                  },
                  "type": "header"
                }
              }
            ],
            "join": "any"
          },
          "elsif": [],
          "enabled": true,
          "name": "Old mail lists",
          "otherwise": null,
          "type": "rule"
        }
      ],
      "preamble": null,
      "requires": [
        "include",
        "variables"
      ],
      "singleFolder": true
    },
    "source": "require [\"include\",\"variables\"];\r\nglobal \"move_to_folder\";\r\n\r\n# rule:[Old mail lists]\r\nif header :contains \"list-id\" \"announce.example\" {\r\n\tset \"move_to_folder\" \"Archive/Lists\";\r\n}\r\n"
  },
  "Mail routing": {
    "rules": {
      "items": [
        {
          "actions": [
            {
              "flags": [
                "$label1"
              ],
              "op": "add",
              "type": "flags"
            },
            {
              "copy": false,
              "create": false,
              "flags": null,
              "mailbox": "Personal/Family",
              "type": "fileInto"
            }
          ],
          "conditions": {
            "items": [
              {
                "negate": false,
                "test": {
                  "headers": [
                    "from"
                  ],
                  "keys": [
                    "mia@example.com"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "type": "is"
                    }
                  },
                  "part": "all",
                  "type": "address"
                }
              }
            ],
            "join": "any"
          },
          "elsif": [],
          "enabled": true,
          "name": "Family",
          "otherwise": null,
          "type": "rule"
        },
        {
          "actions": [
            {
              "copy": false,
              "create": false,
              "flags": null,
              "mailbox": "Clients/Acme",
              "type": "fileInto"
            }
          ],
          "conditions": {
            "items": [
              {
                "negate": false,
                "test": {
                  "headers": [
                    "from"
                  ],
                  "keys": [
                    "acme.example"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "type": "is"
                    }
                  },
                  "part": "domain",
                  "type": "address"
                }
              }
            ],
            "join": "any"
          },
          "elsif": [
            {
              "actions": [
                {
                  "copy": false,
                  "create": false,
                  "flags": null,
                  "mailbox": "Clients/Studio",
                  "type": "fileInto"
                }
              ],
              "conditions": {
                "items": [
                  {
                    "negate": false,
                    "test": {
                      "headers": [
                        "from"
                      ],
                      "keys": [
                        "studio.example"
                      ],
                      "matcher": {
                        "comparator": null,
                        "matchType": {
                          "type": "is"
                        }
                      },
                      "part": "domain",
                      "type": "address"
                    }
                  }
                ],
                "join": "any"
              }
            },
            {
              "actions": [
                {
                  "copy": false,
                  "create": false,
                  "flags": null,
                  "mailbox": "Clients/Billing",
                  "type": "fileInto"
