          ],
          "conditions": {
            "items": [
              {
                "negate": false,
                "test": {
                  "headers": [
                    "from"
                  ],
                  "keys": [
                    "bookstore.example"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "type": "is"
                    }
                  },
                  "part": "domain",
                  "type": "address"
                }
              }
            ],
            "join": "any"
          },
          "elsif": [],
          "enabled": true,
          "name": "",
          "otherwise": null,
          "type": "rule"
        }
      ],
      "preamble": null,
      "requires": [
        "imap4flags",
        "include",
        "variables"
      ],
      "singleFolder": true
    },
    "source": "require [\"imap4flags\",\"include\",\"variables\"];\r\nglobal \"move_to_folder\";\r\n\r\n# rule:[Family]\r\nif address :is \"from\" \"mia@example.com\" {\r\n\taddflag \"$label1\";\r\n\tset \"move_to_folder\" \"Personal/Family\";\r\n}\r\n\r\n# rule:[Clients]\r\nif address :domain :is \"from\" \"acme.example\" {\r\n\tset \"move_to_folder\" \"Clients/Acme\";\r\n} elsif address :domain :is \"from\" \"studio.example\" {\r\n\tset \"move_to_folder\" \"Clients/Studio\";\r\n} elsif header :contains \"subject\" \"invoice\" {\r\n\tset \"move_to_folder\" \"Clients/Billing\";\r\n}\r\n\r\n# rule:[Newsletters]\r\nif exists \"List-Unsubscribe\" {\r\n\tset \"move_to_folder\" \"Reading\";\r\n}\r\n\r\n# rule:[Receipts]\r\nif address :domain :is \"from\" \"shop.example\" {\r\n\tset \"move_to_folder\" \"Receipts/Shop\";\r\n}\r\n\r\nif address :domain :is \"from\" \"bookstore.example\" {\r\n\tset \"move_to_folder\" \"Receipts/Books\";\r\n}\r\n"
  },
  "Spam": {
    "rules": {
      "items": [
        {
          "actions": [
            {
              "copy": false,
              "create": false,
              "flags": null,
              "mailbox": "Junk",
              "type": "fileInto"
            },
            {
              "type": "stop"
            }
          ],
          "conditions": {
            "items": [
              {
                "negate": false,
                "test": {
                  "headers": [
                    "x-spam-flag"
                  ],
                  "keys": [
                    "yes"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "type": "contains"
                    }
                  },
                  "type": "header"
                }
              }
            ],
            "join": "any"
          },
          "elsif": [],
          "enabled": true,
          "name": "Spam",
          "otherwise": null,
          "type": "rule"
        }
      ],
      "preamble": null,
      "requires": [
        "include",
        "variables"
      ],
      "singleFolder": true
    },
    "source": "require [\"include\",\"variables\"];\r\nglobal \"move_to_folder\";\r\n\r\n# rule:[Spam]\r\nif header :contains \"x-spam-flag\" \"yes\" {\r\n\tset \"move_to_folder\" \"Junk\";\r\n\treturn;\r\n}\r\n"
  }
}
