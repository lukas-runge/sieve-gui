    "source": "require [\"body\",\"fileinto\",\"imap4flags\",\"include\",\"regex\",\"variables\"];\r\nglobal \"move_to_folder\";\r\n\r\n# rule:[Known pests]\r\nif anyof (\r\n\theader :contains \"from\" \"offers@ads.example\",\r\n\theader :contains \"from\" \"prize@lottery.example\",\r\n\theader :contains \"from\" \"news@spam-shop.example\"\r\n) {\r\n\tsetflag \"\\\\Seen\";\r\n\tset \"move_to_folder\" \"Junk\";\r\n\treturn;\r\n}\r\n\r\n# rule:[Flagged as spam by the server]\r\nif anyof (\r\n\theader :contains \"x-spam-flag\" \"yes\",\r\n\tallof (\r\n\t\theader :regex \"X-DSPAM-Result\" \"^(Spam|Virus|Bl[ao]cklisted)$\",\r\n\t\tnot header :contains \"X-DSPAM-Reclassified\" \"Innocent\"\r\n\t),\r\n\tallof (\r\n\t\tnot header :regex \"subject\" \"[[:graph:]]\",\r\n\t\tbody :text :regex \"^[[:space:]]*http://[[:graph:]]+[[:space:]]*$\"\r\n\t)\r\n) {\r\n\tif not address :domain :matches \"from\" [\r\n\t\t\"*work.example\",\r\n\t\t\"*family.example\",\r\n\t\t\"*friends.example\"\r\n\t] {\r\n\t\tset \"move_to_folder\" \"Junk\";\r\n\t\treturn;\r\n\t}\r\n}\r\n\r\n# A rule sieve-gui shows as code: it doesn't summarise editheader.\nif header :contains \"subject\" \"[SPAM]\"\n{\n\tdeleteheader \"X-Spam-Score\";\n}\r\n"
