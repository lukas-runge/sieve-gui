    "source": "require [\"copy\",\"editheader\",\"fileinto\",\"imap4flags\",\"include\",\"variables\"];\r\nglobal \"move_to_folder\";\r\n\r\n# rule:[Family]\r\nif address :domain :is \"from\" [\r\n\t\"family.example\",\r\n\t\"grandma.example\"\r\n] {\r\n\taddflag [\"$label1\",\"\\\\Flagged\"];\r\n}\r\n\r\n# rule:[By address]\r\nif header :contains [\"to\",\"cc\",\"bcc\"] \"me@work.example\" {\r\n\tif address :domain :is \"from\" \"client-a.example\" {\r\n\t\taddflag \"$label2\";\r\n\t\tset \"move_to_folder\" \"Work/Clients\";\r\n\t} elsif header :contains \"subject\" [\r\n\t\t\"urgent\",\r\n\t\t\"asap\"\r\n\t] {\r\n\t\taddflag [\"\\\\Flagged\",\"$label5\"];\r\n\t} else {\r\n\t\tset \"move_to_folder\" \"Work\";\r\n\t}\r\n} elsif header :contains [\"to\",\"cc\",\"bcc\"] \"hello@side-project.example\" {\r\n\taddflag \"$label3\";\r\n\tif header :contains \"subject\" \"invoice\" {\r\n\t\taddflag \"$label4\";\r\n\t}\r\n} elsif header :contains [\"to\",\"cc\",\"bcc\"] \"old@freemail.example\" {\r\n\tredirect :copy \"me@personal.example\";\r\n} else {\r\n\tkeep;\r\n}\r\n\r\n# rule:[Newsletters from strangers]\r\nif allof (\r\n\texists \"List-Unsubscribe\",\r\n\tnot address :domain :is \"from\" [\r\n\t\t\"work.example\",\r\n\t\t\"family.example\"\r\n\t]\r\n) {\r\n\taddflag \"\\\\Seen\";\r\n\tset \"move_to_folder\" \"Reading/Newsletters\";\r\n}\r\n\r\n# rule:[Orders]\r\nif header :contains \"subject\" [\r\n\t\"your order\",\r\n\t\"order confirmation\"\r\n] {\r\n\tset \"move_to_folder\" \"Shopping\";\r\n}\r\n\r\nif address :domain :is \"from\" \"bookshop.example\" {\r\n\tset \"move_to_folder\" \"Shopping/Books\";\r\n}\r\n\r\nif address :domain :is \"from\" [\r\n\t\"electronics.example\",\r\n\t\"gadgets.example\"\r\n] {\r\n\tset \"move_to_folder\" \"Shopping/Electronics\";\r\n}\r\n\r\n# rule:[Old forwarding]\r\nif false # header :contains \"to\" \"legacy@work.example\"\r\n{\r\n\tredirect \"archive@work.example\";\r\n}\r\n\r\n# Mark every message that passed this script\naddheader \"X-Sorted-By\" \"sieve\";\r\n"
  },
