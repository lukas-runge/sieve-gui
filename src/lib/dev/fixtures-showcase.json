    "source": "require [\"imap4flags\",\"include\",\"variables\"];\r\nglobal \"move_to_folder\";\r\n\r\n# rule:[Bank]\r\nif address :domain :is \"from\" \"bank.example\" {\r\n\tset \"move_to_folder\" \"Accounts/Finance/Bank\";\r\n}\r\n\r\nif address :domain :is \"from\" \"card.example\" {\r\n\tset \"move_to_folder\" \"Accounts/Finance/Credit card\";\r\n}\r\n\r\nif address :domain :is \"from\" [\r\n\t\"broker.example\",\r\n\t\"savings.example\"\r\n] {\r\n\tset \"move_to_folder\" \"Accounts/Finance/Investments\";\r\n}\r\n\r\n# rule:[Travel]\r\nif address :domain :is \"from\" [\r\n\t\"rail.example\",\r\n\t\"transit.example\"\r\n] {\r\n\tset \"move_to_folder\" \"Accounts/Travel/Trains\";\r\n}\r\n\r\nif address :domain :is \"from\" \"airline.example\" {\r\n\tset \"move_to_folder\" \"Accounts/Travel/Flights\";\r\n}\r\n\r\nif address :domain :is \"from\" [\r\n\t\"hotels.example\",\r\n\t\"rentals.example\"\r\n] {\r\n\tset \"move_to_folder\" \"Accounts/Travel/Stays\";\r\n}\r\n\r\n# rule:[Services]\r\nif address :domain :is \"from\" \"cloud.example\" {\r\n\tset \"move_to_folder\" \"Accounts/Services/Cloud\";\r\n}\r\n\r\nif address :domain :is \"from\" [\r\n\t\"music.example\",\r\n\t\"video.example\"\r\n] {\r\n\tset \"move_to_folder\" \"Accounts/Services/Streaming\";\r\n}\r\n\r\nif address :domain :is \"from\" \"code-host.example\" {\r\n\tset \"move_to_folder\" \"Accounts/Services/Code\";\r\n}\r\n\r\n# rule:[Clubs]\r\nif address :domain :is \"from\" \"sports-club.example\" {\r\n\tset \"move_to_folder\" \"Clubs/Sports\";\r\n}\r\n\r\nif address :domain :is \"from\" \"choir.example\" {\r\n\tset \"move_to_folder\" \"Clubs/Choir\";\r\n}\r\n\r\n# rule:[Big attachments]\r\nif size :over 20M {\r\n\taddflag \"$label6\";\r\n}\r\n"
  },
