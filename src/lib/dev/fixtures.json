{
  "Allgemein": {
    "rules": {
      "items": [
        {
          "actions": [
            {
              "flags": [
                "\\Flagged"
              ],
              "op": "add",
              "type": "flags"
            }
          ],
          "conditions": {
            "items": [
              {
                "negate": false,
                "test": {
                  "headers": [
                    "from"
                  ],
                  "keys": [
                    "boss@example.com"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "type": "contains"
                    }
                  },
                  "type": "header"
                }
              },
              {
                "negate": false,
                "test": {
                  "headers": [
                    "subject"
                  ],
                  "keys": [
                    "urgent"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "type": "contains"
                    }
                  },
                  "type": "header"
                }
              }
            ],
            "join": "all"
          },
          "enabled": true,
          "name": "allof two",
          "type": "rule"
        },
        {
          "actions": [
            {
              "copy": false,
              "create": false,
              "flags": null,
              "mailbox": "Lists/Rust",
              "type": "fileInto"
            }
          ],
          "conditions": {
            "items": [
              {
                "negate": false,
                "test": {
                  "headers": [
                    "from"
                  ],
                  "keys": [
                    "a@example.com"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "type": "contains"
                    }
                  },
                  "type": "header"
                }
              },
              {
                "negate": false,
                "test": {
                  "headers": [
                    "to"
                  ],
                  "keys": [
                    "b@example.com"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "type": "contains"
                    }
                  },
                  "type": "header"
                }
              }
            ],
            "join": "any"
          },
          "enabled": true,
          "name": "anyof two",
          "type": "rule"
        },
        {
          "actions": [
            {
              "flags": null,
              "type": "keep"
            }
          ],
          "conditions": {
            "items": [
              {
                "negate": true,
                "test": {
                  "headers": [
                    "subject"
                  ],
                  "keys": [
                    "[SPAM]"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "type": "contains"
                    }
                  },
                  "type": "header"
                }
              },
              {
                "negate": true,
                "test": {
                  "headers": [
                    "X-Spam-Flag"
                  ],
                  "type": "exists"
                }
              },
              {
                "negate": true,
                "test": {
                  "headers": [
                    "from"
                  ],
                  "keys": [
                    "noreply@example.com"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "type": "is"
                    }
                  },
                  "type": "header"
                }
              }
            ],
            "join": "all"
          },
          "enabled": true,
          "name": "negated",
          "type": "rule"
        },
        {
          "actions": [
            {
              "type": "stop"
            }
          ],
          "conditions": {
            "items": [
              {
                "negate": true,
                "test": {
                  "headers": [
                    "subject"
                  ],
                  "keys": [
                    "*invoice*"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "type": "matches"
                    }
                  },
                  "type": "header"
                }
              },
              {
                "negate": true,
                "test": {
                  "headers": [
                    "subject"
                  ],
                  "keys": [
                    "^re:"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "type": "regex"
                    }
                  },
                  "type": "header"
                }
              }
            ],
            "join": "any"
          },
          "enabled": true,
          "name": "anyof negated",
          "type": "rule"
        },
        {
          "actions": [
            {
              "flags": null,
              "type": "keep"
            }
          ],
          "conditions": {
            "items": [
              {
                "negate": false,
                "test": {
                  "headers": [
                    "subject"
                  ],
                  "keys": [
                    "hello"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "type": "is"
                    }
                  },
                  "type": "header"
                }
              }
            ],
            "join": "any"
          },
          "enabled": true,
          "name": "single test anyof",
          "type": "rule"
        }
      ],
      "preamble": null,
      "requires": [
        "fileinto",
        "imap4flags",
        "regex"
      ],
      "singleFolder": false
    },
    "source": "require [\"fileinto\",\"imap4flags\",\"regex\"];\r\n# rule:[allof two]\r\nif allof (header :contains \"from\" \"boss@example.com\", header :contains \"subject\" \"urgent\")\r\n{\r\n\taddflag \"\\\\Flagged\";\r\n}\r\n# rule:[anyof two]\r\nif anyof (header :contains \"from\" \"a@example.com\", header :contains \"to\" \"b@example.com\")\r\n{\r\n\tfileinto \"Lists/Rust\";\r\n}\r\n# rule:[negated]\r\nif allof (not header :contains \"subject\" \"[SPAM]\", not exists \"X-Spam-Flag\", not header :is \"from\" \"noreply@example.com\")\r\n{\r\n\tkeep;\r\n}\r\n# rule:[anyof negated]\r\nif anyof (not header :matches \"subject\" \"*invoice*\", not header :regex \"subject\" \"^re:\")\r\n{\r\n\tstop;\r\n}\r\n# rule:[single test anyof]\r\nif header :is \"subject\" \"hello\"\r\n{\r\n\tkeep;\r\n}\r\n"
  },
  "Gemischt": {
    "rules": {
      "items": [
        {
          "actions": [
            {
              "copy": false,
              "create": false,
              "flags": null,
              "mailbox": "Lists/Rust",
              "type": "fileInto"
            },
            {
              "type": "stop"
            }
          ],
          "conditions": {
            "items": [
              {
                "negate": false,
                "test": {
                  "headers": [
                    "list-id"
                  ],
                  "keys": [
                    "rust"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "type": "contains"
                    }
                  },
                  "type": "header"
                }
              },
              {
                "negate": false,
                "test": {
                  "headers": [
                    "subject"
                  ],
                  "keys": [
                    "[RFC]*"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "type": "matches"
                    }
                  },
                  "type": "header"
                }
              }
            ],
            "join": "any"
          },
          "enabled": true,
          "name": "Newsletter",
          "type": "rule"
        },
        {
          "code": "if header :matches \"subject\" \"*\" { set \"subject\" \"${1}\"; }",
          "type": "raw"
        },
        {
          "code": "if size :over 5M { fileinto \"Large\"; } elsif header :is \"x-spam\" \"yes\" { discard; } else { keep; }",
          "type": "raw"
        }
      ],
      "preamble": null,
      "requires": [
        "fileinto",
        "variables"
      ],
      "singleFolder": false
    },
    "source": "require [\"fileinto\", \"variables\"];\n# rule:[Newsletter]\nif anyof (header :contains \"list-id\" \"rust\", header :matches \"subject\" \"[RFC]*\") {\n    fileinto \"Lists/Rust\";\n    stop;\n}\nif header :matches \"subject\" \"*\" { set \"subject\" \"${1}\"; }\nif size :over 5M { fileinto \"Large\"; } elsif header :is \"x-spam\" \"yes\" { discard; } else { keep; }\n"
  },
  "Urlaub": {
    "rules": {
      "items": [
        {
          "actions": [
            {
              "addresses": [
                "lukas@example.com",
                "l.runge@example.com"
              ],
              "from": "lukas@example.com",
              "handle": null,
              "mime": false,
              "period": {
                "unit": "days",
                "value": 7
              },
              "reason": "Hallo,\r\n\r\nich bin bis zum 4. Januar nicht im Büro.\r\nIn dringenden Fällen: \"Notfall\" an info@example.com.\r\n.\r\nViele Grüße\r\nLukas\r\n",
              "subject": "Abwesenheit: Urlaub 🌴",
              "type": "vacation"
            }
          ],
          "conditions": {
            "items": [
              {
                "negate": false,
                "test": {
                  "datePart": "iso8601",
                  "keys": [
                    "2026-12-20T08:00:00+01:00"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "op": "ge",
                      "type": "value"
                    }
                  },
                  "type": "currentDate",
                  "zone": "+0100"
                }
              },
              {
                "negate": false,
                "test": {
                  "datePart": "iso8601",
                  "keys": [
                    "2027-01-04T18:30:00+01:00"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "op": "le",
                      "type": "value"
                    }
                  },
                  "type": "currentDate",
                  "zone": "+0100"
                }
              }
            ],
            "join": "all"
          },
          "enabled": true,
          "name": "Out of Office",
          "type": "rule"
        },
        {
          "actions": [
            {
              "copy": false,
              "create": false,
              "flags": null,
              "mailbox": "Steuern/Gesch&AOQ-ftlich",
              "type": "fileInto"
            }
          ],
          "conditions": {
            "items": [
              {
                "negate": false,
                "test": {
                  "headers": [
                    "from"
                  ],
                  "keys": [
                    "@tax-office.example"
                  ],
                  "matcher": {
                    "comparator": null,
                    "matchType": {
                      "type": "contains"
                    }
                  },
                  "type": "header"
                }
              }
            ],
            "join": "all"
          },
          "enabled": true,
          "name": "Existing rule",
          "type": "rule"
        }
      ],
      "preamble": null,
      "requires": [
        "date",
        "fileinto",
        "relational",
        "vacation"
      ],
      "singleFolder": false
    },
    "source": "require [\"date\",\"fileinto\",\"relational\",\"vacation\"];\r\n# rule:[Out of Office]\r\nif allof (currentdate :zone \"+0100\" :value \"ge\" \"iso8601\" \"2026-12-20T08:00:00+01:00\", currentdate :zone \"+0100\" :value \"le\" \"iso8601\" \"2027-01-04T18:30:00+01:00\")\r\n{\r\n\tvacation :days 7 :addresses [\"lukas@example.com\",\"l.runge@example.com\"] :subject \"Abwesenheit: Urlaub 🌴\" :from \"lukas@example.com\" text:\r\nHallo,\r\n\r\nich bin bis zum 4. Januar nicht im Büro.\r\nIn dringenden Fällen: \"Notfall\" an info@example.com.\r\n..\r\nViele Grüße\r\nLukas\r\n.\r\n;\r\n}\r\n# rule:[Existing rule]\r\nif allof (header :contains \"from\" \"@tax-office.example\")\r\n{\r\n\tfileinto \"Steuern/Gesch&AOQ-ftlich\";\r\n}\r\n"
  }
}
